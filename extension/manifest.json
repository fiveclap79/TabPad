{
  "manifest_version": 3,
  "name": "TabPad - 생산성 대시보드",
  "version": "1.0.0",
  "description": "크롬 새 탭(New Tab)을 대체하는 올인원 생산성 대시보드 (메모장, 할 일 관리, 상용구 복사)",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

